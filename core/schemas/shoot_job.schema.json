{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShootJob",
  "description": "Payload sent to local Google Flow bridge (http://localhost:8100) from Stupid Shoot",
  "type": "object",
  "required": ["job_id", "source_type", "prompt", "grid_layout"],
  "properties": {
    "job_id": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": ["DRAFT_CONCEPT", "CATALOG_SKU"]
    },
    "source_id": { "type": "string", "description": "Draft ID or SKU" },
    "prompt": { "type": "string" },
    "grid_layout": { "type": "string", "default": "3x3" },
    "background_color": { "type": "string", "default": "#242424" },
    "phenotype_preset": { "type": "string", "description": "e.g. 'berlin_techno_grunge', 'dark_nomadic'" },
    "reference_images": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output_directory": { "type": "string" },
    "auto_slice": { "type": "boolean", "default": true },
    "status": {
      "type": "string",
      "enum": ["QUEUED", "PROCESSING", "SLICED", "FAILED"],
      "default": "QUEUED"
    }
  }
}
